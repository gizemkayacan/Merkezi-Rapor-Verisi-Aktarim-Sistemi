@inherits LayoutComponentBase
@inject DynamicExcelImport.UI.Services.AuthService AuthService
@implements IDisposable

<PageTitle>DynamicExcelImport.UI</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <!-- SSO Simülasyon Paneli (Üst Bar) -->
        <div class="top-row px-4 bg-light border-bottom d-flex justify-content-between align-items-center" style="height: 3.5rem;">
            <span class="text-muted small">
                <i class="oi oi-person"></i> Aktif Kullanıcı: <strong class="text-dark">@AuthService.CurrentUserName</strong>
                <span class="badge bg-primary ms-2">Rol Kodu: @AuthService.CurrentRoleCode</span>
            </span>

            <div class="d-flex align-items-center">
                <label class="small fw-bold me-2 text-muted mb-0">SSO Simülasyonu:</label>
                <select class="form-select form-select-sm shadow-sm" @onchange="ChangeRole" style="width: 240px; border-radius: 8px;">
                    <option value="1000" selected="@(AuthService.CurrentRoleCode == "1000")">1000 - Risk Departmanı</option>
                    <option value="2000" selected="@(AuthService.CurrentRoleCode == "2000")">2000 - Finans Departmanı</option>
                    <option value="9999" selected="@(AuthService.CurrentRoleCode == "9999")">9999 - Sistem Yöneticisi</option>
                </select>
            </div>
        </div>

        <!-- Ana Sayfa İçeriği -->
        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnRoleChanged += StateHasChanged;
    }

    private void ChangeRole(ChangeEventArgs e)
    {
        string role = e.Value?.ToString() ?? "1000";
        string name = role switch
        {
            "1000" => "Ahmet Yılmaz (Risk Uzmanı)",
            "2000" => "Ayşe Demir (Finans Uzmanı)",
            "9999" => "Mehmet Kaya (Sistem Yöneticisi)",
            _ => "Misafir Kullanıcı"
        };

        AuthService.SetRole(role, name);
    }

    public void Dispose()
    {
        AuthService.OnRoleChanged -= StateHasChanged;
    }
}